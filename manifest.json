{
  "manifest_version": 3,
  "name": "CardWiz — Best Card & Cashback at Checkout",
  "version": "1.0",
  "description": "Best card for max cashback at checkout, 195+ cards compared, bank offers + bill reminders. Privacy-first, India-first.",
  "author": "CardWiz",
  "homepage_url": "https://cardwiz.in",
  "action": {
    "default_popup": "popup-smartcard.html",
    "default_title": "CardWiz — best card batao",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["storage", "alarms", "notifications", "identity"],
  "host_permissions": [
    "https://cardwiz-backend.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.in/*",
        "*://*.flipkart.com/*",
        "*://*.myntra.com/*",
        "*://*.swiggy.com/*",
        "*://*.zomato.com/*",
        "*://*.bigbasket.com/*",
        "*://*.blinkit.com/*",
        "*://*.zeptonow.com/*",
        "*://*.nykaa.com/*",
        "*://*.ajio.com/*",
        "*://*.meesho.com/*",
        "*://*.tatacliq.com/*",
        "*://*.makemytrip.com/*",
        "*://*.cleartrip.com/*",
        "*://*.irctc.co.in/*",
        "*://*.bookmyshow.com/*",
        "*://*.district.in/*"
      ],
      "js": ["debug.js", "i18n.js", "recommend.js", "offers.js", "captracker.js", "affiliate.js", "catalog.js", "content-detect.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/cards.json"],
      "matches": [
        "*://*.amazon.in/*",
        "*://*.flipkart.com/*",
        "*://*.myntra.com/*",
        "*://*.swiggy.com/*",
        "*://*.zomato.com/*",
        "*://*.bigbasket.com/*",
        "*://*.blinkit.com/*",
        "*://*.zeptonow.com/*",
        "*://*.nykaa.com/*",
        "*://*.ajio.com/*",
        "*://*.meesho.com/*",
        "*://*.tatacliq.com/*",
        "*://*.makemytrip.com/*",
        "*://*.cleartrip.com/*",
        "*://*.irctc.co.in/*",
        "*://*.bookmyshow.com/*",
        "*://*.district.in/*"
      ]
    }
  ]
}
